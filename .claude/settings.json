{
  "permissions": {
    "allow": [
      "Bash(npm test)"
    ],
    "ask": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Edit(tests/**)",
      "Write(tests/**)",
      "Edit(spec.md)",
      "Write(spec.md)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(rm * -rf*)",
      "Bash(rm * -fr*)",
      "Bash(glab mr merge)",
      "Bash(glab mr merge *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "branch=$(git -C \"$CLAUDE_PROJECT_DIR\" branch --show-current 2>/dev/null); if [ \"$branch\" = \"main\" ]; then echo 'Make a branch first.' >&2; exit 2; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && out=$(npm test 2>&1) || { printf '%s\\n' \"$out\" >&2; exit 2; }",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
